{
  "name": "ffpanel-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "test": "vitest run --environment jsdom",
    "api:generate": "openapi-typescript ../openapi.json -o src/generated/openapi.ts",
    "check": "npm run api:generate && npm run build && npm test"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "^3.13.12",
    "axios": "^1.11.0",
    "lucide-vue-next": "^0.542.0",
    "pinia": "^3.0.3",
    "reka-ui": "^2.5.0",
    "vue": "^3.5.20",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  }
}
